# --- Telegram (create a bot with @BotFather, add it to the IT group) ---
TELEGRAM_BOT_TOKEN=
# Group/chat id(s) that get alerts, comma separated (group ids start with -100...)
TELEGRAM_CHAT_ID=
# Optional: managers' chat for incidents nobody acknowledged within escalateAfterMin
TELEGRAM_ESCALATION_CHAT_ID=
# Optional: extra Telegram user ids allowed to use /ack /mute in private chat
TELEGRAM_ADMIN_IDS=
# false = alerts only, no /status /ack bot commands (use when another app polls this bot)
TELEGRAM_COMMANDS=true

# --- Other channels (optional) ---
SLACK_WEBHOOK_URL=
# JSON POST per event (n8n / Make / Zapier / PagerDuty bridge); signed with HMAC-SHA256 if a secret is set
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=

# --- Scheduling ---
# node-cron tick (6 fields = seconds). Each monitor still runs on its own "interval".
TICK_CRON=*/5 * * * * *
TIMEZONE=Europe/Berlin
CONCURRENCY=10
# Daily uptime summary to Telegram, e.g. 09:00 every day (empty = off)
DAILY_SUMMARY_CRON=0 9 * * *

# --- Reliability ---
# If all checks fail at once, these URLs are tried first; if they fail too, the monitor's own
# internet is down and no false alerts are sent. Empty = disabled.
CANARY_URLS=https://www.google.com/generate_204,https://1.1.1.1/
# Dead-man switch: pinged every minute (e.g. healthchecks.io) so you know if the monitor itself dies
HEARTBEAT_URL=

# --- Storage / status page ---
DB_FILE=data/uptime.db
RETENTION_DAYS=90
MONITORS_FILE=monitors.json
PORT=8080
STATUS_PAGE_TITLE=ACME Service Status
# Protects /metrics, /api/incidents and full /api/status details (Bearer token or ?token=)
STATUS_API_TOKEN=
LOG_LEVEL=info

# Secrets referenced in monitors.json as ${NAME}
ADMIN_API_TOKEN=
